{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dimer.local/contracts/tabpfn-regressor/artifact-manifest-v1",
  "type":"object","additionalProperties":true,
  "required":["schemaVersion","taskType","targetColumn","featureColumns","fittedEstimator","fittedEstimatorSha256","foundationCheckpoint","foundationCheckpointSha256","portableLoader"],
  "properties":{
    "schemaVersion":{"const":1},"contractVersion":{"type":"integer","minimum":1},"taskType":{"const":"tabular_regression"},
    "targetColumn":{"type":"string","minLength":1},"featureColumns":{"type":"array","items":{"type":"string"},"minItems":1},
    "fittedEstimator":{"type":"string","minLength":1},"fittedEstimatorSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "foundationCheckpoint":{"type":"string","minLength":1},"foundationCheckpointSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "portableLoader":{"type":"string","minLength":1}
  }
}
